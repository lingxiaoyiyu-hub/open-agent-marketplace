{
  "schema": "reverselab.proxy_pipeline_config.v1",
  "description": "\u4ee3\u7406\u7ba1\u9053\u914d\u7f6e \u2014 \u591a\u7ea7\u4ee3\u7406\u4e32\u8054/\u8def\u7531",
  "listen": {
    "host": "127.0.0.1",
    "port": 9090,
    "protocol": "http"
  },
  "hops": [
    {
      "id": "hop1_local",
      "name": "\u672c\u5730 SOCKS5 \u51fa\u53e3",
      "proxy": "socks5://127.0.0.1:1080",
      "timeout_sec": 10,
      "retries": 2,
      "enabled": true
    },
    {
      "id": "hop2_remote",
      "name": "\u8fdc\u7a0b HTTP \u4ee3\u7406",
      "proxy": "http://10.0.0.1:3128",
      "timeout_sec": 15,
      "retries": 1,
      "enabled": false,
      "notes": "\u7b2c\u4e8c\u8df3 \u2014 \u4ec5\u5728\u9700\u8981\u591a\u5c42\u533f\u540d\u65f6\u542f\u7528"
    }
  ],
  "rules": [
    {
      "id": "rule_burp",
      "name": "Burp Suite \u4e0a\u6e38\u4ee3\u7406",
      "comment": "\u6240\u6709 HTTP \u6d41\u91cf\u5148\u8fc7 Burp (8080)\uff0c\u518d\u8fc7\u4ee3\u7406\u6c60",
      "listen": {
        "host": "127.0.0.1",
        "port": 8081
      },
      "target": "hop1_local",
      "match": {
        "protocol": [
          "http",
          "https"
        ]
      },
      "enabled": false
    },
    {
      "id": "rule_pool_round_robin",
      "name": "\u4ee3\u7406\u6c60\u8f6e\u8f6c\u51fa\u53e3",
      "comment": "\u4f7f\u7528 proxy_pool \u7684\u8f6e\u8f6c\u7ed3\u679c\u4f5c\u4e3a\u4e0a\u6e38",
      "listen": {
        "host": "127.0.0.1",
        "port": 9090
      },
      "target": "pool",
      "pool_config": "tools/proxy_pool/proxy_sources.json",
      "pool_state": "tools/proxy_pool/pool_state.json",
      "match": {
        "protocol": [
          "http",
          "https"
        ]
      },
      "enabled": true
    }
  ]
}
