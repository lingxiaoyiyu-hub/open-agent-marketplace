{
  "schema": "reverselab.ai_tool_playbook.v1",
  "purpose": "Task keywords -> tool sequences. Used by scripts/misc/ai_tool.py plan so agents remember which installed tools to use.",
  "rules": [
    {
      "id": "web-first-recon",
      "keywords": [
        "web",
        "website",
        "ctf",
        "http",
        "target",
        "\u7ad9\u70b9",
        "\u7f51\u7ad9",
        "\u76ee\u5f55",
        "\u8def\u7531"
      ],
      "when": "New web/website CTF target or sparse route map.",
      "tools": [
        "ctf.httpx",
        "ctf.katana",
        "ctf.ffuf",
        "ctf.gobuster",
        "ctf.feroxbuster"
      ],
      "kb_files": [
        "01-recon/recon-routing.md",
        "01-recon/version-fingerprinting.md",
        "attack-network.md"
      ],
      "method": "Probe status/tech with httpx; crawl with katana; fuzz routes with ffuf/gobuster/feroxbuster; save raw outputs under exports/ctf-website/<case>.",
      "evidence": "HTTP status/title/headers, discovered URLs, wordlist, response filters."
    },
    {
      "id": "web-injection",
      "keywords": [
        "sqli",
        "sql",
        "nosql",
        "ssti",
        "\u6a21\u677f",
        "\u6ce8\u5165",
        "\u53c2\u6570",
        "\u8868\u5355"
      ],
      "when": "Forms, parameters, JSON APIs, template rendering, search endpoints, or error-based hints.",
      "tools": [
        "ctf.sqlmap",
        "ctf.tplmap",
        "ctf.jwt_tool"
      ],
      "kb_files": [
        "03-injection/sqli-nosqli.md",
        "03-injection/ssti.md",
        "03-injection/prototype-pollution.md",
        "03-injection/graphql.md",
        "03-injection/hpp-crlf.md"
      ],
      "method": "Confirm one narrow input-to-effect path manually, then use sqlmap/tplmap for systematic enumeration; use jwt_tool for token trust boundary checks.",
      "evidence": "Request, payload, response delta, DBMS/template engine fingerprint, extracted proof."
    },
    {
      "id": "web-cve-chain",
      "keywords": [
        "cve",
        "\u7248\u672c",
        "fingerprint",
        "\u6307\u7eb9",
        "geoserver",
        "struts",
        "spring",
        "shiro",
        "\u6f0f\u6d1e\u94fe",
        "\u7ec4\u5408"
      ],
      "when": "Any product/version/banner/header/package evidence appears.",
      "tools": [
        "ctf.searchsploit"
      ],
      "scripts": [
        "scripts/ctf-website/fingerprint_cve_pipeline.py",
        "scripts/ctf-website/cve_graph.py",
        "scripts/ctf-website/cve_chain_planner.py"
      ],
      "kb_files": [
        "09-cve/cve-workflow.md",
        "09-cve/cve-correlation-graph.md",
        "09-cve/multi-cve-chain-playbook.md"
      ],
      "method": "Write cases/<case>/fingerprints.json; run fingerprint_cve_pipeline; inspect graph/chain output; use searchsploit for local exploit references.",
      "evidence": "Fingerprint source, CVE report, EPSS/KEV/CWE/product edges, chain validation steps."
    },
    {
      "id": "web-proxy-manual",
      "keywords": [
        "burp",
        "proxy",
        "cookie",
        "session",
        "\u767b\u5f55",
        "\u9274\u6743",
        "csrf",
        "oauth"
      ],
      "when": "Authenticated browser state, complex session mutation, or manual Repeater/Intruder workflow is needed.",
      "tools": [
        "ctf.burp.jar"
      ],
      "method": "Do not auto-launch in checks. Start Burp only on explicit user request; export decisive requests to cases/<case>/evidence.",
      "evidence": "Raw HTTP request/response, cookies, session diff, replay result."
    },
    {
      "id": "android-apk-static",
      "keywords": [
        "apk",
        "android",
        "dex",
        "manifest",
        "jadx",
        "apktool",
        "\u5b89\u5353",
        "\u53cd\u7f16\u8bd1"
      ],
      "when": "APK/XAPK/JAR/AAR static analysis or endpoint/secret extraction.",
      "tools": [
        "android.apktool",
        "android.jadx"
      ],
      "method": "Use apktool for resources/manifest/smali; use jadx only when registry marks it callable; write outputs to projects/android/<case> and exports/android/<case>.",
      "evidence": "Manifest entries, permissions, strings, endpoints, decompiled class paths."
    },
    {
      "id": "android-repack-sign",
      "keywords": [
        "repack",
        "sign",
        "\u7b7e\u540d",
        "\u91cd\u6253\u5305",
        "frida",
        "hook"
      ],
      "when": "Patch/repack APK or deploy Frida server to emulator/device.",
      "tools": [
        "android.apktool",
        "android.uber_apk_signer",
        "android.frida_server_x86_64"
      ],
      "scripts": [
        "scripts/android/install_frida_server.ps1",
        "scripts/android/repack_apk_entries.py"
      ],
      "method": "Patch copy only; rebuild with apktool; sign with uber-apk-signer; use install_frida_server.ps1 for target-side frida-server.",
      "evidence": "Original hash, patch diff, signed APK path, frida version/process list."
    },
    {
      "id": "windows-pe-triage",
      "keywords": [
        "pe",
        "exe",
        "dll",
        "windows",
        "crackme",
        "malware",
        "\u6837\u672c",
        "\u58f3",
        "patch"
      ],
      "when": "Windows native binary triage or patch/crackme analysis.",
      "tools": [
        "windows.pe_bear",
        "windows.cutter",
        "windows.procmon",
        "windows.hxd"
      ],
      "method": "Automatic checks do file probes only. For analysis use reverse_lab_tools/sample_full_workup first; GUI tools are explicit/manual follow-up.",
      "evidence": "Hashes, imports, strings, sections, entrypoint, behavior logs, patch bytes."
    },
    {
      "id": "jadx-corrupt-repair",
      "keywords": [
        "android",
        "corrupt",
        "jadx",
        "repair",
        "sourceforge"
      ],
      "when": "GitHub release \u4e0b\u8f7d\u4e0d\u7a33\u4e14\u672c\u5730 jadx zip/jar \u635f\u574f",
      "tools": [
        "android.jadx"
      ],
      "method": "\u82e5 jadx \u518d\u635f\u574f\uff0c\u4f18\u5148\u4ece SourceForge mirror \u4e0b\u8f7d v1.5.5 zip\uff0c\u9a8c\u8bc1 zip/jar \u540e\u89e3\u538b\u5230 tools/android/jadx\uff0c\u5e76\u786e\u8ba4 ai_toolcheck android PASS\u3002",
      "evidence": "Tool version output and analysis artifacts produced in the current workspace.",
      "derived_from_findings": [
        "3a7050b7-6b1c-4e05-9bf9-d84973d0f834"
      ]
    },
    {
      "id": "web-auth-jwt",
      "keywords": [
        "jwt",
        "token",
        "eyJ",
        "bearer",
        "jws",
        "jwe",
        "jku",
        "jwk",
        "kid injection",
        "none algorithm"
      ],
      "when": "JWT token found in Authorization header, cookie, or URL param.",
      "tools": [
        "ctf.jwt_tool"
      ],
      "tool_payloads": {
        "ctf.jwt_tool": {
          "wordlists": [
            "tools\\ctf-website\\jwt_tool\\jwt-common.txt",
            "tools\\ctf-website\\jwt_tool\\common-headers.txt",
            "tools\\ctf-website\\jwt_tool\\common-payloads.txt",
            "tools\\ctf-website\\jwt_tool\\jwks-common.txt"
          ],
          "usage": "jwt_tool TOKEN -C -w jwt-common.txt  (\u7206\u7834\u5bc6\u94a5)\njwt_tool TOKEN -X at                      (alg:none)\njwt_tool TOKEN -X k                       (KID\u6ce8\u5165)"
        }
      },
      "kb_files": [
        "02-auth/jwt/00-overview.md",
        "02-auth/jwt/01-alg-none.md",
        "02-auth/jwt/02-algorithm-confusion.md",
        "02-auth/jwt/03-weak-key-bruteforce.md",
        "02-auth/jwt/04-kid-injection.md"
      ],
      "method": "jwt_tool \u63a2\u6d4b\u7b97\u6cd5\u3001\u7206\u7834\u5f31\u5bc6\u94a5\u3001alg:none\u3001KID\u6ce8\u5165\u3002\u5148\u8dd1 -t (scan) \u770b\u6982\u89c8\u3002",
      "evidence": "jwt_token, decoded_header, decoded_payload, attack_result"
    },
    {
      "id": "web-injection-sqli",
      "keywords": [
        "sqli",
        "sql injection",
        "mysql",
        "postgres",
        "database",
        "select",
        "union select",
        "or 1=1"
      ],
      "when": "Forms, URL params, JSON APIs, headers that interact with SQL backend.",
      "tools": [
        "ctf.sqlmap"
      ],
      "tool_payloads": {
        "ctf.sqlmap": {
          "payload_files": [
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\boolean_blind.xml",
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\error_based.xml",
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\inline_query.xml",
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\stacked_queries.xml",
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\time_blind.xml",
            "tools\\ctf-website\\sqlmap\\data\\xml\\payloads\\union_query.xml"
          ],
          "tamper_scripts": "tools\\ctf-website\\sqlmap\\tamper\\  (71\u4e2aWAF\u7ed5\u8fc7\u811a\u672c)",
          "wordlists": [
            "tools\\ctf-website\\sqlmap\\data\\txt\\common-tables.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\common-columns.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\common-files.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\smalldict.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\keywords.txt"
          ],
          "usage": "sqlmap -r request.txt --batch  (\u57fa\u7840)\nsqlmap -r request.txt --tamper=space2comment,charencode --level=5 --risk=3  (WAF\u7ed5\u8fc7)\nsqlmap \u6570\u636e\u53ef\u590d\u7528\u4e8e ffuf/\u624b\u52a8\u6784\u9020"
        }
      },
      "kb_files": [
        "03-injection/sqli-nosqli.md"
      ],
      "method": "\u5148\u624b\u5de5\u786e\u8ba4\u6ce8\u5165\u70b9\uff0c\u518d\u4e0a sqlmap\u3002\u5173\u6ce8 tamper/ \u76ee\u5f55\u7ed5\u8fc7 WAF\u3002sqlmap \u7684 txt \u5b57\u5178\u53ef\u590d\u7528\u4e8e\u5176\u4ed6 fuzz \u5de5\u5177\u3002",
      "evidence": "\u6ce8\u5165\u70b9 URL, parameter, DBMS, extracted data, flag"
    },
    {
      "id": "web-injection-ssti",
      "keywords": [
        "ssti",
        "template injection",
        "jinja2",
        "twig",
        "freemarker",
        "smarty",
        "{{",
        "{%",
        "${"
      ],
      "when": "\u9875\u9762\u56de\u663e\u7528\u6237\u8f93\u5165\uff0c\u6216 500 \u9519\u8bef\u66b4\u9732\u6a21\u677f\u5f15\u64ce\u4fe1\u606f\u3002",
      "tools": [
        "ctf.tplmap"
      ],
      "tool_payloads": {
        "ctf.tplmap": {
          "engines": [
            "tools\\ctf-website\\tplmap\\plugins\\engines\\jinja2.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\twig.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\smarty.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\freemarker.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\velocity.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\erb.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\mako.py",
            "tools\\ctf-website\\tplmap\\plugins\\engines\\tornado.py"
          ],
          "usage": "tplmap.py -u 'URL?param=*' --engine jinja2\n\u4e0d\u6307\u5b9a\u5f15\u64ce\u65f6\u81ea\u52a8\u68c0\u6d4b"
        }
      },
      "kb_files": [
        "03-injection/ssti.md"
      ],
      "method": "\u5148\u7528\u624b\u5de5 {{7*7}} \u786e\u8ba4\u6ce8\u5165\u70b9\uff0c\u518d\u7528 tplmap \u81ea\u52a8\u63a2\u6d4b\u5f15\u64ce\u7c7b\u578b\u548c RCE\u3002",
      "evidence": "SSTI payload, engine fingerprint, RCE proof, flag"
    },
    {
      "id": "web-cve-exploitdb",
      "keywords": [
        "cve",
        "exploitdb",
        "searchsploit",
        "exploit",
        "poc",
        "version exploit"
      ],
      "when": "\u53d1\u73b0\u4ea7\u54c1\u540d\u79f0/\u7248\u672c\u53f7\uff0c\u9700\u8981\u67e5\u5df2\u516c\u5f00 exploit\u3002",
      "tools": [
        "ctf.searchsploit"
      ],
      "tool_payloads": {
        "ctf.searchsploit": {
          "exploit_db": "tools\\ctf-website\\exploitdb\\exploits\\  (45000+ exploits CSV indexed)",
          "exploit_index": "tools\\ctf-website\\exploitdb\\files_exploits.csv",
          "shellcode_db": "tools\\ctf-website\\exploitdb\\shellcodes\\",
          "google_hacking": "tools\\ctf-website\\exploitdb\\ghdb.xml",
          "usage": "searchsploit <product> <version>\nsearchsploit -t <platform>  (shellcode)\nsearchsploit -w <edb-id>       (\u5728\u7ebf\u94fe\u63a5)"
        }
      },
      "kb_files": [
        "09-cve/cve-workflow.md",
        "09-cve/cve-correlation-graph.md",
        "09-cve/multi-cve-chain-playbook.md"
      ],
      "method": "searchsploit \u67e5\u672c\u5730 exploitdb\uff1b\u914d\u5408 fingerprint_cve_pipeline.py \u505aCVE\u56fe\u8c31\u3002",
      "evidence": "CVE-IDs, EDB-IDs, exploit path, exploit result"
    },
    {
      "id": "web-recon-ffuf",
      "keywords": [
        "fuzz",
        "directory",
        "route",
        "dirb",
        "gobuster",
        "feroxbuster",
        "wordlist"
      ],
      "when": "\u9700\u8981\u66b4\u529b\u679a\u4e3e\u76ee\u5f55/\u6587\u4ef6/\u8def\u7531/\u53c2\u6570\u3002",
      "tools": [
        "ctf.ffuf",
        "ctf.gobuster",
        "ctf.feroxbuster",
        "ctf.dirsearch"
      ],
      "tool_payloads": {
        "ctf.dirsearch": {
          "wordlists": [
            "tools\\ctf-website\\dirsearch\\db\\dicc.txt",
            "tools\\ctf-website\\dirsearch\\db\\400_blacklist.txt",
            "tools\\ctf-website\\dirsearch\\db\\403_blacklist.txt",
            "tools\\ctf-website\\dirsearch\\db\\500_blacklist.txt"
          ]
        },
        "ctf.sqlmap_reuse": {
          "wordlists": [
            "tools\\ctf-website\\sqlmap\\data\\txt\\smalldict.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\common-tables.txt",
            "tools\\ctf-website\\sqlmap\\data\\txt\\common-files.txt"
          ],
          "note": "sqlmap \u5185\u7f6e\u5b57\u5178\u53ef\u590d\u7528\u4e3a ffuf \u8f93\u5165"
        }
      },
      "kb_files": [
        "01-recon/recon-routing.md",
        "01-recon/version-fingerprinting.md"
      ],
      "method": "dirsearch \u505a\u9996\u8f6e\u76ee\u5f55\u626b\u63cf\uff1bffuf \u505a\u7cbe\u7ec6\u5316 fuzz\uff08\u53c2\u6570/header/cookie\uff09\u3002\u590d\u7528 sqlmap \u7684 smalldict.txt \u548c common-files.txt \u4f5c\u4e3a ffuf \u5b57\u5178\u3002",
      "evidence": "discovered paths, status codes, response sizes"
    },
    {
      "id": "web-nuclei-scan",
      "keywords": [
        "nuclei",
        "template scan",
        "cve scan",
        "vulnerability scan",
        "exposure scan"
      ],
      "when": "\u6709\u5b58\u6d3b URL \u5217\u8868\uff0c\u9700\u8981\u6279\u91cf\u626b CVE/config/exposure\u3002",
      "tools": [
        "ctf.nuclei"
      ],
      "tool_payloads": {
        "ctf.nuclei": {
          "templates_online": "nuclei -ut (\u66f4\u65b0\u6a21\u677f\u5e93\uff0c\u672c\u5730\u7f13\u5b58 6700+ \u6a21\u677f)",
          "usage": "nuclei -u URL -t cves/             (CVE \u626b\u63cf)\nnuclei -u URL -t exposures/configs/  (\u914d\u7f6e\u6cc4\u9732)\nnuclei -u URL -t vulnerabilities/    (\u6f0f\u6d1e\u626b\u63cf)\nnuclei -l urls.txt -t ~/nuclei-templates/ (\u6279\u91cf)"
        }
      },
      "kb_files": [
        "09-cve/cve-workflow.md"
      ],
      "method": "\u5148 httpx \u505a\u5b58\u6d3b\u63a2\u6d4b\uff0c\u518d nuclei \u6279\u91cf\u626b\u6a21\u677f\u3002\u4f18\u5148 cves/ \u548c exposures/ \u5206\u7c7b\u3002",
      "evidence": "template name, matched URL, severity, extracted info"
    },
    {
      "id": "web-payment-full",
      "keywords": [
        "payment",
        "\u652f\u4ed8",
        "callback",
        "notify",
        "webhook",
        "signature",
        "amount",
        "order",
        "coupon",
        "refund",
        "subscription"
      ],
      "when": "\u652f\u4ed8/\u8ba2\u5355/\u56de\u8c03/\u7b7e\u540d/\u8ba2\u9605/\u5361\u5bc6\u4efb\u4f55\u652f\u4ed8\u7c7b\u653b\u51fb\u9762\u3002",
      "tools": [
        "ctf.ffuf",
