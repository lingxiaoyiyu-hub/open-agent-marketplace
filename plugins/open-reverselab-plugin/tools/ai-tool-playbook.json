          ],
          "note": "JWT \u5f31\u5bc6\u94a5\u5b57\u5178\u53ef\u590d\u7528\u4e8e\u7b7e\u540d\u7206\u7834"
        },
        "mapping_ref": "tools\\ctf-website\\payloads\\TOOL-PAYLOAD-MAP.md"
      },
      "kb_files": [
        "12-payment/payment-logic.md",
        "12-payment/payment-bypass.md",
